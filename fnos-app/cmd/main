#!/bin/bash

TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/fn-docker-to-desktop/var}"
TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/fn-docker-to-desktop/target}"

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
FALLBACK_LOG="/tmp/fn-docker-to-desktop.log"

CMD="${TRIM_APPDEST}/fn-docker-to-desktop"
if [ -f "${TRIM_APPDEST}/app/fn-docker-to-desktop" ]; then
    CMD="${TRIM_APPDEST}/app/fn-docker-to-desktop"
fi

LIFECYCLE_LOG="/tmp/fn-docker-to-desktop-lifecycle.log"

log_msg() {
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    local ts="$(date '+%Y-%m-%d %H:%M:%S.%3N')"
    local msg="[${ts}] [main] $1"
    echo "${msg}" >> "${LOG_FILE}" 2>/dev/null || true
    echo "${msg}" >> "${FALLBACK_LOG}" 2>/dev/null || true
    echo "${msg}" >> "${LIFECYCLE_LOG}" 2>/dev/null || true
    chmod 0666 "${FALLBACK_LOG}" 2>/dev/null || true
    chmod 0666 "${LIFECYCLE_LOG}" 2>/dev/null || true
    if [ -n "${TRIM_PKGVAR}" ] && [ -d "${TRIM_PKGVAR}/logs" ]; then
        echo "${msg}" >> "${TRIM_PKGVAR}/logs/lifecycle.log" 2>/dev/null || true
    fi
}

start_process() {
    local start_t=$(date +%s%3N)
    if status; then
        return 0
    fi

    log_msg "Starting fn-docker-to-desktop..."
    mkdir -p "${TRIM_PKGVAR}/data" 2>/dev/null || true
    mkdir -p "${TRIM_PKGVAR}/logs" 2>/dev/null || true

    if [ ! -f "${CMD}" ]; then
        log_msg "Executable not at ${CMD}, searching in ${TRIM_APPDEST}..."
        FOUND_CMD=$(find "${TRIM_APPDEST}" -type f -name "fn-docker-to-desktop" 2>/dev/null | head -n 1)
        if [ -n "${FOUND_CMD}" ]; then
            CMD="${FOUND_CMD}"
            log_msg "Found executable at ${CMD}"
        else
            log_msg "ERROR: Executable fn-docker-to-desktop not found anywhere in ${TRIM_APPDEST}"
            return 1
        fi
    fi

    chmod +x "${CMD}" 2>/dev/null || true

    ICON_ARG=""
    if [ -f "${TRIM_APPDEST}/ICON_256.PNG" ]; then
        ICON_ARG="-icon ${TRIM_APPDEST}/ICON_256.PNG"
    elif [ -f "${TRIM_APPDEST}/ICON.PNG" ]; then
        ICON_ARG="-icon ${TRIM_APPDEST}/ICON.PNG"
    fi

    PORT_ARG=""
    if [ -n "${PORT}" ]; then
        PORT_ARG="-port ${PORT}"
    fi

    SOCK_ARG=""
    if [ -n "${TRIM_APPDEST}" ]; then
        SOCK_ARG="-socket ${TRIM_APPDEST}/app.sock"
    fi

    "${CMD}" -data "${TRIM_PKGVAR}/data" ${ICON_ARG} ${PORT_ARG} ${SOCK_ARG} >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "Started fn-docker-to-desktop with PID ${pid}"

    local sock_path=""
    if [ -n "${TRIM_APPDEST}" ]; then
        sock_path="${TRIM_APPDEST}/app.sock"
    fi

    local waited=0
    # 等待进程就绪并确保 unix socket 监听建立（最多等待 8 秒）
    while [ ${waited} -lt 40 ]; do
        if ! check_process "${pid}"; then
            log_msg "ERROR: Process ${pid} exited immediately after startup! Check ${LOG_FILE} and ${FALLBACK_LOG}"
            if [ -f "${LOG_FILE}" ]; then
                tail -n 30 "${LOG_FILE}" >> "${FALLBACK_LOG}" 2>/dev/null || true
            fi
            return 1
        fi
        if [ -z "${sock_path}" ] || [ -S "${sock_path}" ]; then
            break
        fi
        sleep 0.2
        waited=$((waited + 1))
    done

    if [ -n "${sock_path}" ] && [ -S "${sock_path}" ]; then
        log_msg "Unix socket ${sock_path} is ready (waited $((waited * 200))ms)."
    fi

    local end_t=$(date +%s%3N)
    log_msg "Process ${pid} is healthy and running (start_process took $((end_t - start_t))ms)."
    return 0
}

stop_process() {
    local stop_start_t=$(date +%s%3N)
    log_msg "Stopping fn-docker-to-desktop..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            local stop_end_t=$(date +%s%3N)
            log_msg "Process ${pid} was not running, cleaned PID file (stop_process took $((stop_end_t - stop_start_t))ms)."
            return 0
        fi

        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done

        if check_process "${pid}"; then
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        fi
    fi

    rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null || true
    local stop_end_t=$(date +%s%3N)
    log_msg "fn-docker-to-desktop stopped successfully (stop_process took $((stop_end_t - stop_start_t))ms)."
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi    
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
