#!/bin/bash

TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/fn-docker-to-desktop/var}"
TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/fn-docker-to-desktop/target}"

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

CMD="${TRIM_APPDEST}/fn-docker-to-desktop"
if [ -f "${TRIM_APPDEST}/app/fn-docker-to-desktop" ]; then
    CMD="${TRIM_APPDEST}/app/fn-docker-to-desktop"
fi

log_msg() {
    mkdir -p "${TRIM_PKGVAR}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting fn-docker-to-desktop..."
    mkdir -p "${TRIM_PKGVAR}/data"
    mkdir -p "${TRIM_PKGVAR}/logs"

    if [ ! -x "${CMD}" ]; then
        chmod +x "${CMD}" 2>/dev/null || true
    fi

    ICON_ARG=""
    if [ -f "${TRIM_APPDEST}/ICON_256.PNG" ]; then
        ICON_ARG="-icon ${TRIM_APPDEST}/ICON_256.PNG"
    elif [ -f "${TRIM_APPDEST}/ICON.PNG" ]; then
        ICON_ARG="-icon ${TRIM_APPDEST}/ICON.PNG"
    fi

    PORT_ARG=""
    if [ -n "${PORT}" ]; then
        PORT_ARG="-port ${PORT}"
    fi

    "${CMD}" -data "${TRIM_PKGVAR}/data" ${ICON_ARG} ${PORT_ARG} >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "Started fn-docker-to-desktop with PID ${pid}"
    return 0
}

stop_process() {
    log_msg "Stopping fn-docker-to-desktop..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            return
        fi

        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done

        if check_process "${pid}"; then
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi    
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
