#!/bin/bash
# ==============================================================================
# fn-docker-to-desktop 卸载回调清理脚本 (uninstall_callback)
# ==============================================================================

LOG_FILE="/tmp/fn-docker-to-desktop-uninstall.log"
log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [callback] $1"
    echo "${msg}" >> "${LOG_FILE}" 2>/dev/null || true
    chmod 0666 "${LOG_FILE}" 2>/dev/null || true
}

log_msg "执行卸载后置清理 (瞬时完成)..."
rm -rf /tmp/fndocker_* 2>/dev/null || true
rm -f /tmp/fn-docker-to-desktop.sock 2>/dev/null || true
log_msg "卸载后置清理完成"
exit 0
