#!/bin/bash
# ==============================================================================
# fn-docker-to-desktop 卸载回调清理脚本 (uninstall_callback)
# ==============================================================================

LOG_FILE="/tmp/fn-docker-to-desktop-uninstall.log"
LIFECYCLE_LOG="/tmp/fn-docker-to-desktop-lifecycle.log"

log_msg() {
    local ts="$(date '+%Y-%m-%d %H:%M:%S')"
    local msg="[${ts}] [uninstall_callback] $1"
    echo "${msg}" >> "${LOG_FILE}" 2>/dev/null || true
    echo "${msg}" >> "${LIFECYCLE_LOG}" 2>/dev/null || true
    chmod 0666 "${LOG_FILE}" 2>/dev/null || true
    chmod 0666 "${LIFECYCLE_LOG}" 2>/dev/null || true
    if [ -n "${TRIM_PKGVAR}" ] && [ -d "${TRIM_PKGVAR}/logs" ]; then
        echo "${msg}" >> "${TRIM_PKGVAR}/logs/lifecycle.log" 2>/dev/null || true
    fi
}

start_t=$(date +%s%3N)
UPGRADE_FLAG="/tmp/fn-docker-to-desktop-upgrading"
if [ -f "${UPGRADE_FLAG}" ]; then
    log_msg "检测到处于应用覆盖升级/重装阶段，跳过卸载后置清理并保留环境"
    exit 0
fi

log_msg "执行卸载后置清理 (PID: $$)..."
rm -rf /tmp/fndocker_* 2>/dev/null || true
rm -f /tmp/fn-docker-to-desktop.sock 2>/dev/null || true
end_t=$(date +%s%3N)
log_msg "卸载后置清理完成 (耗时: $((end_t - start_t))ms)"
exit 0
